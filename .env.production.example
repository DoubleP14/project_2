# ─── News Trends – PRODUKCIÓS környezeti változók mintája ───
# A szerveren másold le .env néven a projekt gyökerébe:  cp .env.production.example .env
# Véletlen értékek generálása:  openssl rand -hex 32

# Domain (https:// nélkül)
DOMAIN=newstrends.hu

# Adatbázis (a docker-compose ebből építi fel a DATABASE_URL-t)
# A jelszó csak betűt és számot tartalmazzon (openssl rand -hex 24), mert URL-be kerül
POSTGRES_USER=newstrends
POSTGRES_PASSWORD=
POSTGRES_DB=newstrends

# Biztonság – ÚJ, véletlen értékek (openssl rand -hex 32)
JWT_SECRET=
CRON_SECRET=
# FIGYELEM: ha a helyi adatbázist költözteted, az ENCRYPTION_KEY-nek meg kell egyeznie a helyivel,
# különben a mentett API kulcsok nem fejthetők vissza! Új adatbázisnál generálj újat.
ENCRYPTION_KEY=

# Opcionális API kulcsok
OPENAI_API_KEY=
YOUTUBE_API_KEY=

# E-mail küldés
# Élesben (felhős szerveren) a Resend HTTPS API ajánlott, mert az SMTP portok jellemzően le vannak tiltva.
# Ha a RESEND_API_KEY ki van töltve, az SMTP beállítások nem kellenek.
RESEND_API_KEY=
MAIL_FROM="News Trends <ertesites@newstrends.hu>"
# Alternatíva: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telegram értesítések
TELEGRAM_BOT_TOKEN=

# Fizetés (Stripe) és számlázás (Számlázz.hu)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SZAMLAZZ_API_KEY=

# Google bejelentkezés (opcionális) – Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Engedélyezett átirányítási cím: https://<domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
