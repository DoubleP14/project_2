# ─── News Trends – környezeti változók mintája ───
# Másold le .env néven, és töltsd ki a saját értékeiddel. A .env fájl SOHA ne kerüljön verziókezelésbe!

# Adatbázis (PostgreSQL) – a README-ben szereplő Docker paranccsal egyező értékek
DATABASE_URL="postgresql://admin:JELSZO@localhost:5433/app_db?schema=public"

# Biztonság
JWT_SECRET="hosszu-veletlen-szoveg-a-munkamenet-tokenek-alairasahoz"
ENCRYPTION_KEY="hosszu-veletlen-szoveg-az-api-kulcsok-titkositasahoz"
CRON_SECRET="hosszu-veletlen-szoveg-a-kulso-cron-vegponthoz"

# Opcionális API kulcsok
# OPENAI_API_KEY: szigorú BYOK mellett nem használt, üresen hagyható
OPENAI_API_KEY=""
# YOUTUBE_API_KEY: tartalék kulcs, ha a felhasználó nem ad meg sajátot
YOUTUBE_API_KEY=""

# E-mail küldés: RESEND_API_KEY megadása esetén HTTPS API-n (Resend), egyébként SMTP-n megy ki a levél
RESEND_API_KEY=""
MAIL_FROM=""
# SMTP – pl. Gmail esetén alkalmazásjelszó szükséges
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="pelda@gmail.com"
SMTP_PASS="alkalmazas-jelszo"

# Telegram értesítések (BotFather által adott token)
TELEGRAM_BOT_TOKEN=""

# Fizetés (Stripe teszt mód) és számlázás (Számlázz.hu sandbox)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
SZAMLAZZ_API_KEY=""

# Google bejelentkezés (opcionális) – Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Engedélyezett átirányítási cím: https://<domain>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
